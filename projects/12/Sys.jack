/**
 * A library that supports various program execution services.
 */
class Sys {

    /** Performs all the initializations required by the OS. */
    function void init() {
        // Order matters: Memory first (everyone else allocates), Math before
        // Screen/Output (they use its bit masks), then the user's program.
        do Memory.init();
        do Math.init();
        do Screen.init();
        do Output.init();
        do Keyboard.init();
        do Main.main();
        do Sys.halt();
        return;
    }

    /** Halts the program execution. */
    function void halt() {
        while (true) {}     // the Hack CPU has no halt instruction - spin forever
        return;
    }

    /** Waits approximately duration milliseconds and returns.  */
    function void wait(int duration) {
        var int i, j;
        // Busy-wait. The inner count is a rough calibration for the VM emulator;
        // on real (much faster or slower) hardware it would be re-tuned.
        let i = 0;
        while (i < duration) {
            let j = 0;
            while (j < 70) {
                let j = j + 1;
            }
            let i = i + 1;
        }
        return;
    }

    /** Displays the given error code in the form "ERR<errorCode>",
     *  and halts the program's execution. */
    function void error(int errorCode) {
        do Output.printString("ERR");
        do Output.printInt(errorCode);
        do Sys.halt();
        return;
    }
}
