// File name: projects/1/Mux.hdl
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    // out = (a AND NOT sel) OR (b AND sel), built straight from Nands:
    // the Or-of-Ands collapses into a Nand-of-Nands (De Morgan).
    Nand(a=sel , b=sel , out=selNot );
    Nand(a=a , b=selNot , out=aPick );
    Nand(a=b , b=sel , out=bPick );
    Nand(a=aPick , b=bPick , out=out );
}