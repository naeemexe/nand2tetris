/** 8-way Or gate: out = in[0] Or in[1] Or ... Or in[7] */

CHIP Or8Way {
    IN in[8];
    OUT out;

    PARTS:
    Or(a=in[0] , b=in[1] , out=Lcomp1 );
    Or(a=in[2] , b=in[3] , out=Lcomp2 );
    Or(a=in[4] , b=in[5] , out=Lcomp3 );
    Or(a=in[6] , b=in[7] , out=Lcomp4 );

    Or(a=Lcomp1 , b=Lcomp2 , out=Mcomp1 );
    Or(a=Lcomp3 , b=Lcomp4 , out=Mcomp2 );

    Or(a=Mcomp1 , b=Mcomp2 , out=out );
}