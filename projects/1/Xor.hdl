/** Exclusive-or gate: if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Nand(a=a , b=b , out=aNot );
    Nand(a=b , b=b , out=bNot );
    Nand(a=a , b=bNot , out=NandABnot );
    Nand(a=aNot , b=b , out=NandAnotB );
    Nand(a=NandABnot , b=NandAnotB , out=out );
}